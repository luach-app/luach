# luach settings. Copy to .env and fill in; docker compose reads it.
# Every value here is a placeholder. A commented line shows the default, or an example
# for a feature that is off until it is set. The guide is docs/SELF-HOSTING.md.

# --- Required ---------------------------------------------------------------------

# Password for the bundled Postgres (docker-compose.yml builds the database URLs from it).
# Make one with `openssl rand -hex 24`. Set it before the first start: the database keeps the
# password it was created with, and changing it here later locks luach out of it.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The address people open luach at, without a trailing slash. Links in mail, passkeys and
# OAuth callbacks are built from it. Use your HTTPS address once a proxy is in front.
LUACH_APP_URL=http://localhost:8004
# The household's time zone (IANA name).
LUACH_TIMEZONE=America/New_York
# The first account needs a one-time setup code, which luach prints to its log
# (docker compose logs luach) while it has no accounts. Set this only to pin the code for
# automation; a long random string, removed once the owner exists.
# LUACH_SETUP_CODE=replace-with-a-long-random-string
# Any OpenAI-compatible chat completions endpoint (Ollama, vLLM, LiteLLM, OpenRouter...).
# luach has no default: without this and LUACH_MODEL the calendar works and the assistant
# says no model is set up.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# Its API key; any non-empty string for a server that does not check one.
OPENAI_API_KEY=replace-me
# The household's model to start with, as that endpoint names it. It must support tool
# calling. The owner can choose another default later in Settings > Household > Models.
LUACH_MODEL=your-model-id

# --- Compose ----------------------------------------------------------------------

# Which build of luach to run, a tag of ghcr.io/luach-app/luach: main (the default) is the
# latest; a commit's short sha (for example a1b2c3d) pins that build until you change it.
# LUACH_VERSION=main
# Compose files to use together, separated by ":" (";" on Windows). docker-compose.yml is
# always first; add the ones you want:
#   compose.caddy.yml   HTTPS for LUACH_APP_URL, with a certificate from Let's Encrypt
#   compose.search.yml  a private SearXNG, for web search
#   compose.build.yml   build the image from this checkout instead of pulling it
# COMPOSE_FILE=docker-compose.yml:compose.caddy.yml
# The secret compose.search.yml's SearXNG needs: `openssl rand -hex 32`.
# SEARXNG_SECRET=

# --- Household --------------------------------------------------------------------

# The household's name, as in "the Rivera household calendar". Empty: "the household calendar".
# LUACH_HOUSEHOLD_NAME=Rivera
# People the family roster should hold, added at start if missing: Name[:adult|kid[:email]], ";"-separated.
# LUACH_FAMILY=Robin; Sam:kid; Noa:kid
# Who runs this luach, named on the public About and Privacy pages.
# LUACH_OPERATOR_NAME=Robin Rivera
# Where those pages send questions and account deletion requests.
# LUACH_CONTACT_EMAIL=calendar@example.com
# The Privacy page's paragraph on which models see what members ask, and where they run.
# LUACH_PRIVACY_MODELS=Questions are answered by a model running on our own computer at home.

# --- Calendar ---------------------------------------------------------------------

# local (the default): events live in luach's own database. google: a Google calendar (needs
# a credential below; without one luach refuses to start). fake: in memory, lost on every
# restart, for tests only.
LUACH_CALENDAR=local
# Which Google credential to use: auto (the OAuth grant when both files are set, else the
# service account), oauth or sa.
# LUACH_CALENDAR_AUTH=auto
# The calendar luach starts with; more can be chosen in Settings > Household.
# LUACH_GOOGLE_CALENDAR_ID=family-calendar-id@group.calendar.google.com
# A service account's JSON key file; share the calendar with its address.
# LUACH_GOOGLE_SA_KEY=/run/luach/google-sa.json
# OAuth client file, {"client_id", "client_secret"}, for the household's own Google grant.
# LUACH_GOOGLE_OAUTH_CLIENT=/run/luach/google-oauth-client.json
# That grant's refresh token file, {"refresh_token"}.
# LUACH_GOOGLE_OAUTH_TOKENS=/run/luach/google-oauth-tokens.json

# --- Outgoing mail ----------------------------------------------------------------

# Resend API key, for invitations, password resets, confirmations and bookings. Unset: no mail.
# RESEND_API_KEY=re_replace_me
# The sender, on a domain verified at Resend. Unset: Resend's shared test sender.
# LUACH_MAIL_FROM=luach <calendar@example.com>
# Where replies go.
# LUACH_MAIL_REPLY_TO=calendar@example.com

# --- Incoming mail (Gmail) --------------------------------------------------------

# Google OAuth client file ("Web application") members connect their own Gmail through.
# Register <LUACH_APP_URL>/api/mail/callback as its redirect URI. Unset: connecting is not offered.
# LUACH_MAIL_OAUTH_CLIENT=/run/luach/mail-oauth-client.json
# A Google Workspace domain whose accounts alone may connect (an Internal app there).
# LUACH_MAIL_DOMAIN=example.com
# Fernet key that encrypts each member's Gmail grant. Unset: a mail.key file in the state volume.
# LUACH_MAIL_KEY=replace-with-output-of-Fernet.generate_key
# Minutes between email scans of members who turned the scan on; 0 switches the scan off.
# LUACH_MAIL_SCAN_MIN=10
# Minutes between checks of the owner's Gmail label (needs the household OAuth grant); 0 is off.
# LUACH_GMAIL_POLL_MIN=0
# The Gmail label that turns a message into a request; handled ones move to <label>/done.
# LUACH_GMAIL_LABEL=luach

# --- Sign-in ----------------------------------------------------------------------

# Session cookies carry Secure. Set 0 only to try luach over plain http on a non-localhost address.
# LUACH_COOKIE_SECURE=1
# Passkey relying-party id. Default: the host name of LUACH_APP_URL.
# LUACH_RP_ID=calendar.example.com
# More origins a passkey may be used from, comma-separated.
# LUACH_EXTRA_ORIGINS=https://other.example.com
# Failed sign-ins for one account from one address before that pair is locked out.
# LUACH_LOGIN_MAX_ATTEMPTS=8
# Failed sign-ins for one account from all addresses together before it is locked out.
# LUACH_LOGIN_ACCOUNT_MAX_ATTEMPTS=30
# How long that lockout lasts, in seconds.
# LUACH_LOGIN_LOCKOUT_SECS=300

# Single sign-on (OIDC). Off until issuer, client id and secret are set and the group is not empty.
# Issuer exactly as the provider publishes it, trailing slash included.
# LUACH_OIDC_ISSUER=https://sso.example.com/application/o/luach/
# LUACH_OIDC_CLIENT_ID=replace-me
# LUACH_OIDC_CLIENT_SECRET=replace-me
# The group a member must hold at the provider; set but empty switches single sign-on off.
# LUACH_OIDC_REQUIRED_GROUP=admins
# The button's text on the sign-in screen.
# LUACH_OIDC_LABEL=Sign in with single sign-on
# Scopes requested from the provider.
# LUACH_OIDC_SCOPES=openid email profile groups
# The userinfo claim that holds the groups.
# LUACH_OIDC_GROUPS_CLAIM=groups
# The userinfo claim that holds the email address.
# LUACH_OIDC_EMAIL_CLAIM=email
# The redirect URI registered at the provider. Default: <LUACH_APP_URL>/api/auth/oidc/callback.
# LUACH_OIDC_REDIRECT_URI=https://calendar.example.com/api/auth/oidc/callback
# Seconds for each call to the provider.
# LUACH_OIDC_HTTP_TIMEOUT=10

# A key another program sends as x-luach-key to act as the owner. Unset: no such access.
# At least 32 random characters: make one with `openssl rand -hex 32`. luach refuses to
# start with a shorter one or with a placeholder. It cannot manage members, sign-in, mail,
# notifications or screens.
# LUACH_API_KEY=
# The name that key's actions carry on the audit trail.
# LUACH_API_KEY_NAME=service
# A narrower key: reads, and talks to the agent, whose gate still decides every write; it never
# approves. Its actions are recorded as "tulip". Must differ from LUACH_API_KEY.
# LUACH_TULIP_KEY=     (also `openssl rand -hex 32`)

# --- Model ------------------------------------------------------------------------

# The menu members may choose a model from, as JSON; ids as the endpoint names them. Read
# once, into the database, on the first start; after that the owner manages the menu in
# Settings > Household > Models. "local": true marks a model on your own computer.
# LUACH_MODELS=[{"id":"your-model-id","name":"Home model","about":"Runs on our own computer.","local":true}]
# Where the Models screen lists models from, when not the endpoint's own /models, and what to
# put before each id it lists. For a LiteLLM router with an openrouter/* route:
# LUACH_MODEL_CATALOGUE_URL=https://openrouter.ai/api/v1/models
# LUACH_MODEL_CATALOGUE_PREFIX=openrouter/
# How many "Try it" runs (about fifteen model turns each) may start in 24 hours.
# LUACH_MODEL_TRIALS_PER_DAY=6
# A Postgres server where "Try it" may create a throwaway database (a role with CREATEDB).
# Unset: a throwaway schema in luach's own database.
# LUACH_EVALS_DATABASE_URL=
# Let the model reason before answering. Off: on the models tested it cost tool calls.
# LUACH_ENABLE_THINKING=0
# How many model calls one turn may take.
# LUACH_MAX_ITERATIONS=16

# --- Optional features ------------------------------------------------------------

# Voice: the full URL of an OpenAI-compatible transcription endpoint.
# LUACH_TRANSCRIBE_URL=http://host.docker.internal:8000/v1/audio/transcriptions
# Its bearer key; unset sends none.
# LUACH_TRANSCRIBE_KEY=replace-me
# The transcription model id.
# LUACH_TRANSCRIBE_MODEL=whisper-1
# Or a command that takes one audio file path and prints its transcript (the URL wins if both are set).
# LUACH_TRANSCRIBE_CMD=/usr/local/bin/transcribe

# Web search: a SearXNG instance with the JSON format enabled. Unset: no web search.
# With compose.search.yml it is http://searxng:8080.
# LUACH_SEARCH_URL=http://searxng:8080

# Push notifications: a VAPID key pair, appended to this file by
# `docker compose run --rm --no-deps -T luach python - < scripts/gen_vapid.py >> .env`.
# LUACH_VAPID_PUBLIC=replace-me
# LUACH_VAPID_PRIVATE=replace-me
# How push services reach the operator (mailto: or https:). Default: LUACH_APP_URL when https.
# LUACH_VAPID_SUBJECT=mailto:calendar@example.com

# Zoom links for booked meetings: a Server-to-Server OAuth app's three credentials.
# LUACH_ZOOM_ACCOUNT_ID=replace-me
# LUACH_ZOOM_CLIENT_ID=replace-me
# LUACH_ZOOM_CLIENT_SECRET=replace-me

# Days a conversation nobody returns to is kept; 0 keeps them all.
# LUACH_THREAD_RETENTION_DAYS=60
# How many of a conversation's latest turns, whole, the model is sent each time.
# LUACH_HISTORY_TURNS=20

# --- Memory -----------------------------------------------------------------------

# Postgres (with pgvector) for what luach remembers about each member. Unset: no memory tool.
# docker-compose.yml sets it to the bundled database.
# LUACH_MEMORY_DSN=postgresql://luach:password@db:5432/luach
# The table those facts are kept in.
# LUACH_MEMORY_TABLE=member_facts
# The embedding model (fastembed); the image ships this one.
# LUACH_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Where the embedding model is kept. The image sets /opt/luach/embed.
# LUACH_EMBED_CACHE=/opt/luach/embed
# A writable directory for the embedder's scratch files. Default: the system temp directory.
# LUACH_EMBED_SCRATCH=/tmp

# --- Server -----------------------------------------------------------------------

# The database (Postgres). docker-compose.yml sets it from POSTGRES_PASSWORD.
# LUACH_DATABASE_URL=postgresql://luach:password@db:5432/luach
# Networks whose X-Forwarded-For / CF-Connecting-IP headers are believed (CIDRs, comma-separated).
# The last one is the subnet docker-compose.yml pins, where a reverse proxy reaches luach from
# (the caddy service, or the gateway for a proxy on the host). Without it every member shares
# the proxy's address, and a few wrong passwords lock a member out for everyone. Change it
# only together with the subnet in docker-compose.yml.
LUACH_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.31.208.0/24
# Address and port the server binds. The image sets 0.0.0.0 and 8004.
# LUACH_HOST=0.0.0.0
# LUACH_PORT=8004
# Log level.
# LUACH_LOG_LEVEL=INFO
# Directory for the mail key, conversation checkpoints and the loops' lock. The image sets /var/lib/luach.
# LUACH_STATE_DIR=/var/lib/luach
# Where conversation checkpoints go. Default: <LUACH_STATE_DIR>/threads.
# LUACH_CHECKPOINT_DIR=/var/lib/luach/threads
# The built web app. The image sets /opt/luach/web/dist.
# LUACH_STATIC_DIR=/opt/luach/web/dist

# --- Development only -------------------------------------------------------------

# A Postgres role that may create databases, for the mail evals (python -m luach.agent.mail_evals).
# LUACH_EVALS_DATABASE_URL=postgresql://luach@127.0.0.1:55437/postgres
# Point the Gmail and Google OAuth calls at a stand-in (fixtures/gmail-fake). Never set in production.
# LUACH_GMAIL_API=https://gmail.googleapis.com/gmail/v1/users/me
# LUACH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# LUACH_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# LUACH_GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
