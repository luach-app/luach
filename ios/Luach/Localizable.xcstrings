    "%@ answered, but it is not a luach. Check the address with whoever set it up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondió, pero no es un luach. Comprueba la dirección con quien lo configuró."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת %@ ענה, אבל הוא לא luach. בדקו את הכתובת עם מי שהגדיר אותו."
          }
        }
      }
    },
    "%@ are invited.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ están invitados."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנות יישלחו ל־%@."
          }
        }
      }
    },
    "%@ in, %@ out per million tokens": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ de entrada, %2$@ de salida por millón de tokens"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ קלט, %2$@ פלט למיליון טוקנים"
          }
        }
      }
    },
    "%@ is back where it was.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha vuelto a su sitio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטלנו את ההזזה של %@."
          }
        }
      }
    },
    "%@ is invited.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está invitado."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמנה תישלח ל־%@."
          }
        }
      }
    },
    "%@ is now %@’s.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ahora es de %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העברנו את %1$@ אל %2$@."
          }
        }
      }
    },
    "%@ is now the family’s.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ahora es de la familia."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העברנו את %@ למשפחה."
          }
        }
      }
    },
    "%@ is told by email, the Zoom link is taken down, and the slot is free again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se avisa a %@ por correo, se quita el enlace de Zoom y el hueco vuelve a quedar libre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ יקבל הודעה במייל, קישור ה־Zoom יוסר, והזמן יתפנה שוב."
          }
        }
      }
    },
    "%@ moved to %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pasa al %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזזנו את %1$@ ל%2$@."
          }
        }
      }
    },
    "%@ on %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ el %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ב%2$@"
          }
        }
      }
    },
    "%@ repeats. Delete only this one, or every one?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se repite. ¿Borrar solo este o todos?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ חוזר על עצמו. למחוק רק את זה, או את כולם?"
          }
        }
      }
    },
    "%@ runs outside the house, at %@. What you ask luach, and the calendar, task and email details it looks up to answer, are sent there to be answered. You can change this here at any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ funciona fuera de casa, en %2$@. Lo que le preguntas a luach, y los datos de calendario, tareas y correo que consulta para responder, se envían allí para ser respondidos. Puedes cambiarlo aquí cuando quieras."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ פועל מחוץ לבית, אצל %2$@. מה ששואלים את luach, ופרטי היומן, המשימות והדוא״ל שהוא בודק כדי לענות, נשלחים לשם כדי לקבל תשובה. אפשר לשנות את זה כאן בכל עת."
          }
        }
      }
    },
    "%@ runs outside the house. What you ask luach, and the calendar, task and email details it looks up to answer, are sent to its provider to be answered. You can change this here at any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funciona fuera de casa. Lo que le preguntas a luach, y los datos de calendario, tareas y correo que consulta para responder, se envían a su proveedor para ser respondidos. Puedes cambiarlo aquí cuando quieras."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ פועל מחוץ לבית. מה ששואלים את luach, ופרטי היומן, המשימות והדוא״ל שהוא בודק כדי לענות, נשלחים לספק שלו כדי לקבל תשובה. אפשר לשנות את זה כאן בכל עת."
          }
        }
      }
    },
