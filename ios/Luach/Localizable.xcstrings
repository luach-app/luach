            "value": "בערב שלפני, רשימה של מחר"
          }
        }
      }
    },
    "The events that are yours, and the ones that are everyone’s.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos que son tuyos, y los que son de todos."
          }
        },
        "he": {
