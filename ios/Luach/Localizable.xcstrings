            "state": "translated",
            "value": "Se repite: cámbialo en el editor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה חוזר על עצמו — שנו את זה בחלון העריכה."
          }
        }
      }
    },
