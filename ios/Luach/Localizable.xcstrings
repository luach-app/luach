    },
    "Turn on “Runs at home” only for a model on the household's own machine: members are not asked before their questions go to it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa «Funciona en casa» solo para un modelo en el propio ordenador del hogar: a los miembros no se les pregunta antes de que sus preguntas vayan a él."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו „פועל בבית” רק למודל שרץ על המחשב של הבית: חברי הבית לא נשאלים לפני שהשאלות שלהם נשלחות אליו."
          }
        }
      }
    },
    "Turn the feed off?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desactivar el calendario suscrito?"
          }
