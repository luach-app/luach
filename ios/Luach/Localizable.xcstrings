    "Swipe a fact to forget it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un dato para olvidarlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו פריט כדי לשכוח אותו."
          }
        }
      }
    },
    "Swipe a window to remove it, or add a second one for a split day.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una franja para quitarla, o añade otra para partir el día."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו חלון זמן כדי להסיר אותו, או הוסיפו חלון שני ליום מפוצל."
          }
        }
      }
    },
    "Swipe an invitation to revoke it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una invitación para revocarla."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו הזמנה כדי לבטל אותה."
          }
        }
      }
    },
    "Swipe to cancel one. Cancelling tells them by email, takes the Zoom link down, and frees the slot.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para cancelar una. Al cancelar se les avisa por correo, se quita el enlace de Zoom y se libera el hueco."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החליקו כדי לבטל פגישה. ביטול שולח להם הודעה במייל, מסיר את קישור ה־Zoom ומפנה את הזמן."
          }
        }
      }
    },
    "Task": {
