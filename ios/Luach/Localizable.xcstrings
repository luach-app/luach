        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו לא נראית כמו כתובת. נסו משהו כמו luach.example.com."
          }
        }
      }
    },
    "That is not an email address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no es una dirección de correo."
