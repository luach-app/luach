    "luach needs a model that can use tools.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "luach necesita un modelo que pueda usar herramientas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "luach צריך מודל שיכול להשתמש בכלים."
          }
        }
      }
    },
    "luach runs on your household's own server. Ask whoever set it up for its address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "luach funciona en el servidor propio de tu casa. Pide la dirección a quien lo configuró."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "luach פועל על השרת של הבית שלכם. בקשו את הכתובת ממי שהגדיר אותו."
          }
        }
      }
    },
    "luach stops reading it. You can add it again with its address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "luach deja de leerlo. Puedes volver a añadirlo con su dirección."
          }
