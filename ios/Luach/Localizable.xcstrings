    "Share one link. People see only the times you are free, and can take at most %lld a day. Times are in %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un solo enlace. La gente ve solo las horas en que estás libre y puede reservar como mucho %1$lld al día. Las horas están en %2$@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתפים קישור אחד. אנשים רואים רק את הזמנים הפנויים, ויכולים לקבוע עד %1$lld ביום. השעות לפי ⁦%2$@⁩."
          }
        }
      }
    },
