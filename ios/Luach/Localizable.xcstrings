          }
        }
      }
    },
    "We will email you a reset link if that address belongs to a member. It expires in 30 minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te enviaremos un enlace para restablecerla si esa dirección es de un miembro. Caduca en 30 minutos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשלח אליך במייל קישור לאיפוס אם הכתובת שייכת לחבר בבית. הוא בתוקף ל-30 דקות."
